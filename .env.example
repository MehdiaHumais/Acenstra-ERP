# ============================================================================
# Ascentra Food Distribution ERP — Environment Configuration Example
# Copy to .env and replace placeholder values before production deployment.
# ============================================================================

# Application
NODE_ENV="development"
# Set this to the real public URL in production. The auth middleware uses it
# for login/invite redirects; leaving a localhost value here or behind a proxy
# that forwards Host: localhost:<port> sends users to an unreachable login page.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_API_URL=""

# Invitation / notification email (SMTP)
# All three of SMTP_HOST, SMTP_USER and SMTP_PASS must be set on the server, or
# invitations are created without emailing and the admin must share the link.
# SMTP_SECURE=ssl is implicit TLS (normally port 465); "starttls" (default) is
# port 587. Explicitly set these in the production environment too — a value in
# a local .env does not reach the deployed app.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="starttls"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Ascentra Global Ltd"
SMTP_FROM_EMAIL=""

# Database
# DB_ENGINE=sqlite (default) runs on the bundled local SQLite file.
# DB_ENGINE=postgres runs on Supabase/PostgreSQL using DATABASE_URL below.
# Use the Supabase POOLED connection string (port 6543), not the direct IPv6 host.
DB_ENGINE="sqlite"
DATABASE_URL="postgresql://postgres.PROJECT_REF:CHANGE_ME_PASSWORD@<pooler-host>:6543/postgres"
SQLITE_DB_PATH="./data/ascentra-erp.sqlite"

# Authentication & Security
AUTH_SECRET="replace-with-at-least-32-bytes-of-cryptographic-random-secret"
MFA_ENCRYPTION_KEY="replace-with-at-least-32-bytes-aes256-gcm-secret-key"
JWT_ISSUER="ascentra-erp"
JWT_AUDIENCE="ascentra-erp-client"
ACCESS_TOKEN_TTL="900"
REFRESH_TOKEN_TTL="604800"
SESSION_COOKIE_NAME="ascentra_session"
SESSION_TTL_SECONDS="28800"
RATE_LIMIT_MAX_REQUESTS="120"
RATE_LIMIT_WINDOW_MS="60000"

# Redis (Optional — used for distributed caching & background job queues when configured)
REDIS_URL="redis://localhost:6379/0"

# Italy SdI Electronic Invoicing Adapter (Sandbox / Disabled until contracted)
SDI_MODE="sandbox"
SDI_PROVIDER_URL="https://sandbox.sdi-provider.example.it/v1"
SDI_API_KEY="placeholder-sdi-api-key"
SDI_TRANSMITTER_COUNTRY="IT"
SDI_TRANSMITTER_VAT="IT00000000000"

# Governed AI & OmniRoute Central Gateway
AI_PROVIDER="omniroute"
OMNIROUTE_BASE_URL="http://77.237.239.69:20128/v1"
OMNIROUTE_API_KEY=""
OMNIROUTE_MODEL="GLM-5"
OMNIROUTE_TIMEOUT_MS="8000"
OMNIROUTE_MAX_RETRIES="0"
OMNIROUTE_CIRCUIT_COOLDOWN_MS="60000"
OMNIROUTE_ENABLED="true"
AI_API_KEY=""
AI_MODEL="GLM-5"

# External Integrations (Pending client discovery approval)
IOT_WEBHOOK_SECRET="placeholder-iot-webhook-secret"
EDI_PARTNER_ID=""
BANK_RECONCILIATION_MODE="csv_import"
