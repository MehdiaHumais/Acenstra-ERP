# ============================================================================
# Ascentra Food Distribution ERP — Environment Configuration Example
# Copy to .env and replace placeholder values before production deployment.
# ============================================================================

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_API_URL=""

# Database (PostgreSQL via Prisma in production; local SQLite fallback when unset)
DATABASE_URL="postgresql://ascentra_user:CHANGE_ME_PASSWORD@localhost:5432/ascentra_erp?schema=public"
ASCENTRA_DB_PATH="./data/ascentra-erp.sqlite"

# Authentication & Security
AUTH_SECRET="replace-with-at-least-32-bytes-of-cryptographic-random-secret"
MFA_ENCRYPTION_KEY="replace-with-at-least-32-bytes-aes256-gcm-secret-key"
JWT_ISSUER="ascentra-erp"
JWT_AUDIENCE="ascentra-erp-client"
ACCESS_TOKEN_TTL="900"
REFRESH_TOKEN_TTL="604800"
SESSION_COOKIE_NAME="ascentra_session"
SESSION_TTL_SECONDS="28800"
RATE_LIMIT_MAX_REQUESTS="120"
RATE_LIMIT_WINDOW_MS="60000"

# Redis (Optional — used for distributed caching & background job queues when configured)
REDIS_URL="redis://localhost:6379/0"

# Italy SdI Electronic Invoicing Adapter (Sandbox / Disabled until contracted)
SDI_MODE="sandbox"
SDI_PROVIDER_URL="https://sandbox.sdi-provider.example.it/v1"
SDI_API_KEY="placeholder-sdi-api-key"
SDI_TRANSMITTER_COUNTRY="IT"
SDI_TRANSMITTER_VAT="IT00000000000"

# Governed AI & OmniRoute Central Gateway
AI_PROVIDER="omniroute"
OMNIROUTE_BASE_URL="http://77.237.239.69:20128/v1"
OMNIROUTE_API_KEY=""
OMNIROUTE_MODEL="GLM-5"
OMNIROUTE_TIMEOUT_MS="35000"
OMNIROUTE_MAX_RETRIES="2"
OMNIROUTE_ENABLED="true"
AI_API_KEY=""
AI_MODEL="GLM-5"

# External Integrations (Pending client discovery approval)
IOT_WEBHOOK_SECRET="placeholder-iot-webhook-secret"
EDI_PARTNER_ID=""
BANK_RECONCILIATION_MODE="csv_import"
